# Copy to .env and fill in real values. NEVER commit .env.
# Every value below is a placeholder. No real credential belongs in this file.

# --- Gnani (app.gnani.ai/voice) ---
# Used for: Prisma batch STT (lecture ingestion), Prisma streaming STT (live voice), Timbre TTS.
GNANI_API_KEY=dummy-gnani-api-key

# --- LiveKit Cloud ---
# Used for: WebRTC room transport, agent worker connection, room token minting.
LIVEKIT_URL=https://your-project.livekit.cloud
LIVEKIT_API_KEY=dummy-livekit-api-key
LIVEKIT_API_SECRET=dummy-livekit-api-secret

# --- Google Gemini ---
# Workload A (notes generation). Long context, structured output, technical vocabulary.
GOOGLE_API_KEY=dummy-google-api-key

# --- Groq ---
# Workload B (conversational doubts). Low time-to-first-token, streaming.
GROQ_API_KEY=dummy-groq-api-key

# --- Google sign-in (OpenID Connect) ---
# Fill both in for any deployment: without them data routes answer 401.
# For a local demo only, set OPEN_MODE=true to run open (no login screen).
# Configuring credentials always wins over OPEN_MODE.
OPEN_MODE=false
#   1. console.cloud.google.com -> APIs & Services -> Credentials
#      -> OAuth client ID (Web application)
#   2. Add these exact Authorized redirect URIs (no wildcards):
#        http://127.0.0.1:8000/api/auth/google/callback
#        http://localhost:5173/api/auth/google/callback
#   3. Add your address as a Test user while the app is in testing mode.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Origin of the frontend while Vite serves it in development. Leave empty
# in production, where this process serves the built frontend itself.
FRONTEND_URL=http://localhost:5173
# Extra origins allowed to call the API with credentials, comma-separated.
ALLOWED_ORIGINS=
# Signing key for the session cookie. Empty means a random key is generated
# once and stored in DATA_DIR/.session_secret (survives restarts).
SESSION_SECRET=
# Unset: derived from FRONTEND_URL (Secure when it is an https:// URL).
# Set true/false only to override that derivation, e.g. behind a TLS proxy.
SESSION_COOKIE_SECURE=

# --- Optional model overrides ---
# The defaults in backend/app/config.py are the models measured to work
# with this project's key. Change these only if your key can reach them.
#
# Notes LLM (Workload A). gemini-4-* models reject temperature/top_p/top_k,
# so none is set. gemini-4-argon needs a quota tier this project did not
# have on 2026-10-22.
LLM_MODEL_NOTES=gemini-3.5-flash
LLM_MODEL_NOTES_SEGMENTS=gemini-3.5-flash
# Chat LLM (Workload B). Low time-to-first-token; the answer is spoken
# aloud, so pick a model that streams content without a reasoning preamble.
LLM_MODEL_CHAT=qwen/qwen3.8-27b

# --- Abuse limits (sliding window, per client IP) ---
# Generous by default so a classroom of students is never throttled; lower
# them on a public deployment.
RATE_LIMIT_WRITE_PER_MINUTE=120
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=30
# Per-account lecture cap and operator emails (comma separated, case
# insensitive). 0 disables the cap; admins bypass it and may read the
# read-only /api/admin/overview endpoint.
MAX_LECTURES_PER_USER=25
ADMIN_EMAILS=
# Hosted agent: fetch lecture context from the deployed API instead of the
# local SQLite file. Both must be set for the HTTP path to be used.
AGENT_API_URL=
AGENT_API_TOKEN=
# At most this many simultaneous outbound HTTP calls per API process.
MAX_OUTBOUND_CONCURRENT=8
# Ingest-cache retention. A directory older than this and unreferenced by
# any lecture or transcript is removed by a periodic sweep.
CACHE_TTL_DAYS=30
CACHE_PRUNE_INTERVAL_SECONDS=3600
CACHE_PRUNER_ENABLED=true

# --- Lecture validation floors ---
# A file shorter than this is rejected before transcription is paid for.
MIN_AUDIO_DURATION_SECONDS=5
# A transcript shorter than either floor is not a lecture; it is rejected
# after transcription instead of producing a useless empty course.
MIN_LECTURE_WORDS=40
MIN_LECTURE_CHARACTERS=200
