# Copy to .env and fill in real values. NEVER commit .env.
# Every value below is a placeholder. No real credential belongs in this file.

# --- Gnani (app.gnani.ai/voice) ---
# Used for: Prisma batch STT (lecture ingestion), Prisma streaming STT (live voice), Timbre TTS.
GNANI_API_KEY=dummy-gnani-api-key

# --- LiveKit Cloud ---
# Used for: WebRTC room transport, agent worker connection, room token minting.
LIVEKIT_URL=https://your-project.livekit.cloud
LIVEKIT_API_KEY=dummy-livekit-api-key
LIVEKIT_API_SECRET=dummy-livekit-api-secret

# --- Google Gemini ---
# Workload A (notes generation). Long context, structured output, technical vocabulary.
GOOGLE_API_KEY=dummy-google-api-key

# --- Groq ---
# Workload B (conversational doubts). Low time-to-first-token, streaming.
GROQ_API_KEY=dummy-groq-api-key

# --- Optional model overrides (defaults are the ones chosen in RECONNAISSANCE.md) ---
# Notes LLM. gemini-4-* models reject temperature/top_p/top_k, so none is set.
LLM_MODEL_NOTES=gemini-4-argon
LLM_MODEL_NOTES_SEGMENTS=gemini-3.8-flash
# Chat LLM.
LLM_MODEL_CHAT=llama-3.3-70b-versatile
